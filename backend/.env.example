NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Supabase Postgres via session pooler (5432). Ikke bruk transaction pooler (6543):
# den tar ikke med schema/search_path, og da feiler rå SQL-spørringer.
DATABASE_URL="postgresql://USER.PROJECT_REF:PASSWORD@aws-0-eu-north-1.pooler.supabase.com:5432/postgres?schema=app"
DIRECT_URL="postgresql://USER.PROJECT_REF:PASSWORD@aws-0-eu-north-1.pooler.supabase.com:5432/postgres?schema=app"

# Minst 32 tegn i produksjon: openssl rand -hex 32
JWT_SECRET=

# Supabase Storage (privat bucket, signerte URL-er). Tom nøkkel = lokal disk (backend/uploads/).
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=files
# Levetid for signerte nedlastings-URL-er i sekunder
SUPABASE_SIGNED_URL_TTL=300

MAX_FILE_SIZE_MB=50

# Valgfritt: passord for seed-brukere
SEED_PASSWORD=

# Valgfritt: web push (npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Logg inn med Google (valgfritt). Opprett en OAuth-klient (Web application) i
# Google Cloud Console med redirect-URI <APP_URL>/auth/google/callback.
APP_URL=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Domener som får konto automatisk ved første Google-innlogging (kommaseparert)
GOOGLE_ALLOWED_DOMAINS=foocus.ai

# Dashboard: read-only connection to the CRM (Ronja) database. The user can only
# read the kpi.crm_summary and kpi.pipeline_by_stage views (totals, no client data).
RONJA_KPI_DATABASE_URL=

# Dashboard: Google Analytics 4. A service account with Viewer access on the property.
# Locally: GA4_CREDENTIALS_FILE=ga4-service-account.json. On Render: paste the key
# file's JSON (one line) into GA4_CREDENTIALS_JSON.
GA4_PROPERTY_ID=
GA4_CREDENTIALS_FILE=
GA4_CREDENTIALS_JSON=

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  OWNER
  ADMIN
  MEMBER
  GUEST
}

enum ChannelRole {
  OWNER
  MODERATOR
  MEMBER
}

model User {
  id            Int       @id @default(autoincrement())
  email         String    @unique @db.VarChar(255)
  password      String    @db.VarChar(255)
  name          String    @db.VarChar(100)
  avatar        String?   @db.VarChar(500)
  status        String?   @default("online") @db.VarChar(20)
  bio           String?   @db.VarChar(500)
  role          Role      @default(MEMBER)
  deactivatedAt DateTime?
  tokenVersion  Int       @default(0)
  lastSeen      DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt

  messages          Message[]
  channels          ChannelMember[]
  reactions         Reaction[]
  dmReactions       DMReaction[]
  files             File[]
  sentDMs           DirectMessage[]    @relation("SentMessages")
  receivedDMs       DirectMessage[]    @relation("ReceivedMessages")
  channelReads      ChannelRead[]
  bookmarks         Bookmark[]
  scheduledMessages ScheduledMessage[]
  inviteLinks       InviteLink[]
  auditLogs         AuditLog[]
  pushSubscriptions PushSubscription[]
  webhooks          Webhook[]
  foldersCreated    Folder[]           @relation("FoldersCreated")
  documentsCreated  Document[]         @relation("DocumentsCreated")
  documentsUpdated  Document[]         @relation("DocumentsUpdated")
  documentVersions  DocumentVersion[]  @relation("DocumentVersions")
}

model InviteLink {
  id        Int       @id @default(autoincrement())
  code      String    @unique @db.VarChar(64)
  createdBy Int
  role      Role      @default(MEMBER)
  maxUses   Int?
  useCount  Int       @default(0)
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  creator   User      @relation(fields: [createdBy], references: [id])
}

model Channel {
  id          Int       @id @default(autoincrement())
  name        String    @unique @db.VarChar(80)
  topic       String?   @db.VarChar(250)
  description String?   @db.VarChar(1000)
  isPrivate   Boolean   @default(false)
  // Group DM: a hidden private channel shown under Direct messages
  isGroupDM   Boolean   @default(false)
  createdBy   Int?
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())

  messages          Message[]
  members           ChannelMember[]
  reads             ChannelRead[]
  scheduledMessages ScheduledMessage[]
  webhooks          Webhook[]
  folders           Folder[]
  documents         Document[]
  libraryFiles      File[]             @relation("LibraryFiles")
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  action     String   @db.VarChar(100)
  actorId    Int
  targetType String   @db.VarChar(50)
  targetId   Int?
  targetName String?  @db.VarChar(200)
  details    String?
  createdAt  DateTime @default(now())

  actor User @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([actorId])
}

model ChannelMember {
  userId    Int
  channelId Int
  role      ChannelRole @default(MEMBER)
  joinedAt  DateTime    @default(now())

  user    User    @relation(fields: [userId], references: [id])
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@id([userId, channelId])
}

model Message {
  id        Int       @id @default(autoincrement())
  content   String
  userId    Int
  channelId Int
  threadId  Int?
  isPinned  Boolean   @default(false)
  pinnedBy  Int?
  pinnedAt  DateTime?
  editedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  deletedAt DateTime?

  user         User          @relation(fields: [userId], references: [id])
  channel      Channel       @relation(fields: [channelId], references: [id], onDelete: Cascade)
  reactions    Reaction[]
  files        File[]
  parent       Message?      @relation("MessageThread", fields: [threadId], references: [id])
  replies      Message[]     @relation("MessageThread")
  bookmarks    Bookmark[]
  channelReads ChannelRead[] @relation("ChannelReadMessage")

  @@index([channelId, createdAt])
  @@index([threadId])
}

model Reaction {
  id        Int      @id @default(autoincrement())
  emoji     String   @db.VarChar(50)
  userId    Int
  messageId Int
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([userId, messageId, emoji])
  @@index([messageId])
}

model File {
  id           Int      @id @default(autoincrement())
  filename     String   @db.VarChar(255)
  originalName String   @db.VarChar(255)
  mimetype     String   @db.VarChar(127)
  size         Int
  url          String
  storagePath  String?
  userId       Int
  messageId    Int?
  dmId         Int?
  // Files uploaded straight into a channel's library (Docs tab), optionally in a folder
  channelId    Int?
  folderId     Int?
  createdAt    DateTime @default(now())

  user    User           @relation(fields: [userId], references: [id])
  message Message?       @relation(fields: [messageId], references: [id], onDelete: SetNull)
  dm      DirectMessage? @relation(fields: [dmId], references: [id], onDelete: SetNull)
  channel Channel?       @relation("LibraryFiles", fields: [channelId], references: [id], onDelete: Cascade)
  folder  Folder?        @relation(fields: [folderId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([messageId])
  @@index([dmId])
  @@index([channelId, folderId])
}

// Documents belong to a channel and inherit its access (channel membership).
model Folder {
  id        Int      @id @default(autoincrement())
  channelId Int
  parentId  Int?
  name      String   @db.VarChar(120)
  createdBy Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  channel   Channel    @relation(fields: [channelId], references: [id], onDelete: Cascade)
  parent    Folder?    @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  Folder[]   @relation("FolderTree")
  creator   User       @relation("FoldersCreated", fields: [createdBy], references: [id])
  documents Document[]
  files     File[]

  @@index([channelId, parentId])
}

model Document {
  id          Int       @id @default(autoincrement())
  channelId   Int
  folderId    Int?
  title       String    @db.VarChar(200)
  // BlockNote blocks (JSON); contentText is the plain text for search and the AI agent
  content     Json
  contentText String    @default("")
  createdBy   Int
  updatedBy   Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  // Trash: soft-deleted documents can be restored
  deletedAt   DateTime?

  channel  Channel           @relation(fields: [channelId], references: [id], onDelete: Cascade)
  folder   Folder?           @relation(fields: [folderId], references: [id], onDelete: SetNull)
  creator  User              @relation("DocumentsCreated", fields: [createdBy], references: [id])
  updater  User              @relation("DocumentsUpdated", fields: [updatedBy], references: [id])
  versions DocumentVersion[]

  @@index([channelId, folderId])
  @@index([deletedAt])
}

model DocumentVersion {
  id          Int      @id @default(autoincrement())
  documentId  Int
  title       String   @db.VarChar(200)
  content     Json
  contentText String   @default("")
  createdBy   Int
  createdAt   DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  author   User     @relation("DocumentVersions", fields: [createdBy], references: [id])

  @@index([documentId, createdAt])
}

model DirectMessage {
  id         Int       @id @default(autoincrement())
  content    String
  fromUserId Int
  toUserId   Int
  threadId   Int?
  isPinned   Boolean   @default(false)
  pinnedBy   Int?
  pinnedAt   DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt
  editedAt   DateTime?
  deletedAt  DateTime?
  readAt     DateTime?

  fromUser  User            @relation("SentMessages", fields: [fromUserId], references: [id])
  toUser    User            @relation("ReceivedMessages", fields: [toUserId], references: [id])
  parent    DirectMessage?  @relation("DMThread", fields: [threadId], references: [id])
  replies   DirectMessage[] @relation("DMThread")
  reactions DMReaction[]
  files     File[]

  @@index([fromUserId, toUserId])
  @@index([toUserId, fromUserId])
  @@index([threadId])
}

model DMReaction {
  id        Int      @id @default(autoincrement())
  emoji     String   @db.VarChar(50)
  userId    Int
  dmId      Int
  createdAt DateTime @default(now())

  user User          @relation(fields: [userId], references: [id])
  dm   DirectMessage @relation(fields: [dmId], references: [id], onDelete: Cascade)

  @@unique([userId, dmId, emoji])
  @@index([dmId])
}

model Bookmark {
  id        Int      @id @default(autoincrement())
  userId    Int
  messageId Int
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([userId, messageId])
  @@index([userId])
}

model ChannelRead {
  id                Int      @id @default(autoincrement())
  userId            Int
  channelId         Int
  lastReadMessageId Int?
  updatedAt         DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id])
  channel         Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  lastReadMessage Message? @relation("ChannelReadMessage", fields: [lastReadMessageId], references: [id], onDelete: SetNull)

  @@unique([userId, channelId])
}

model ScheduledMessage {
  id          Int      @id @default(autoincrement())
  content     String
  channelId   Int
  userId      Int
  scheduledAt DateTime
  createdAt   DateTime @default(now())
  sent        Boolean  @default(false)

  user    User    @relation(fields: [userId], references: [id])
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([scheduledAt, sent])
  @@index([userId])
}

model PushSubscription {
  id        Int      @id @default(autoincrement())
  userId    Int
  endpoint  String
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, endpoint])
  @@index([userId])
}

model Webhook {
  id         Int       @id @default(autoincrement())
  name       String    @db.VarChar(100)
  channelId  Int
  token      String    @unique @db.VarChar(64)
  createdBy  Int
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt
  lastUsedAt DateTime?

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  creator User    @relation(fields: [createdBy], references: [id])

  @@index([channelId])
  @@index([token])
}

// Dashboard (owners/admins). CRM metrics are snapshots of the Ronja CRM totals;
// manual metrics are entered by admins. Values form a time series per metric.
model KpiMetric {
  id        Int        @id @default(autoincrement())
  key       String     @unique @db.VarChar(80)
  label     String     @db.VarChar(80)
  // NOK | count | percent
  unit      String     @default("count") @db.VarChar(20)
  // crm | manual
  source    String     @default("manual") @db.VarChar(20)
  sortOrder Int        @default(100)
  createdAt DateTime   @default(now())
  values    KpiValue[]
}

model KpiValue {
  id         Int       @id @default(autoincrement())
  metricId   Int
  value      Float
  capturedAt DateTime  @default(now())
  createdBy  Int?
  metric     KpiMetric @relation(fields: [metricId], references: [id], onDelete: Cascade)

  @@index([metricId, capturedAt])
}

// LinkedIn company page, imported from LinkedIn's Analytics → Content export
// (one row per day; re-importing overwrites the same days).
model LinkedinDailyMetric {
  id                   Int      @id @default(autoincrement())
  date                 DateTime @unique @db.Date
  impressions          Int      @default(0)
  impressionsSponsored Int      @default(0)
  uniqueImpressions    Int      @default(0)
  clicks               Int      @default(0)
  reactions            Int      @default(0)
  comments             Int      @default(0)
  reposts              Int      @default(0)
  importedAt           DateTime @default(now())
}
